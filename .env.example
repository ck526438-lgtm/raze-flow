# Copiez ce fichier en « .env » puis lancez : node --env-file=.env src/server.js
PORT=5678
# 127.0.0.1 = accessible seulement depuis cette machine. 0.0.0.0 = accessible depuis le réseau.
HOST=127.0.0.1

# Protection par mot de passe (indispensable si le serveur est accessible depuis Internet)
RAZE_USER=admin
RAZE_PASSWORD=changez-moi

# Dossier des données (workflows, historique, fichiers)
# RAZE_DATA_DIR=./data
# Nombre d'exécutions conservées dans l'historique
# RAZE_MAX_EXECUTIONS=200
# Autoriser le nœud « Commande système » (dangereux : à activer en connaissance de cause)
# RAZE_ALLOW_EXEC=true

# Vos secrets, utilisables dans les nœuds avec {{ $env.NOM }}
# TELEGRAM_TOKEN=
# OPENAI_API_KEY=
# SMTP_PASS=
