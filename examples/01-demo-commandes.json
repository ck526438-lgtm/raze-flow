      "position": {
        "x": 320,
        "y": 200
      },
      "params": {
        "code": "// Données d'exemple (montants en FCFA)\nreturn [\n  { client: 'Awa', ville: 'Abidjan', montant: 45000 },\n  { client: 'Koffi', ville: 'Bouaké', montant: 8000 },\n  { client: 'Mariam', ville: 'Yamoussoukro', montant: 120000 },\n  { client: 'Yao', ville: 'Abidjan', montant: 3500 },\n];\n"
      }
    },
    {
