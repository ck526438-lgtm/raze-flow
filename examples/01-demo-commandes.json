      "id": "total",
      "type": "code",
      "name": "Calculer le total",
      "position": {
        "x": 1360,
        "y": 200
      },
      "params": {
        "code": "const total = items.reduce((somme, c) => somme + c.montant, 0);\nreturn {\n  commandes: items.length,\n  vip: items.filter((c) => c.categorie === 'VIP').length,\n  total,\n  resume: `${items.length} commandes pour ${total.toLocaleString('fr-FR')} FCFA`,\n};\n"
      }
    }
